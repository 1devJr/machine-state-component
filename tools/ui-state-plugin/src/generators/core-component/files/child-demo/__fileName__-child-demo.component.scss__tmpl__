:host {
  display: block;
  color: #111827;
  container-type: inline-size;
}

.child-demo {
  display: grid;
  gap: 0.95rem;
  border: 1px solid #d1d5db;
  border-radius: 1rem;
  padding: 1rem;
  background: #fff;
}

.child-demo__header,
.child-demo__metrics {
  display: grid;
  gap: 0.75rem;
}

.child-demo__header h3,
.child-demo__header p,
.child-demo__notes p {
  margin: 0;
}

.child-demo__header p {
  color: #4b5563;
  font-size: 0.92rem;
  line-height: 1.55;
}

.child-demo__header button {
  font: inherit;
  border: 1px solid #d1d5db;
  background: #fff;
  color: inherit;
  padding: 0.65rem 0.85rem;
  border-radius: 0.8rem;
  justify-self: start;
  cursor: pointer;
}

.child-demo__metrics {
  margin: 0;
  grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
}

.child-demo__metrics dt {
  font-size: 0.8rem;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.child-demo__metrics dd {
  margin: 0.2rem 0 0;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.child-demo__notes {
  display: grid;
  gap: 0.55rem;
}

.child-demo__notes ul {
  margin: 0;
  padding-left: 1rem;
}

@container (min-width: 44rem) {
  .child-demo__header {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
  }
}
