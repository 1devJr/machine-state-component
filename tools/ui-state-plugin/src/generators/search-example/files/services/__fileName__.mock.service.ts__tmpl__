import { Injectable } from '@angular/core';
import { <%= className %>Details } from '../store/<%= fileName %>.types';

const MOCK_ITEMS = ['result-1', 'result-2', 'result-3'] as const;

@Injectable({
  providedIn: 'root',
})
export class <%= className %>MockService {
  readonly #details = new Map<string, <%= className %>Details>(
    MOCK_ITEMS.map((name, index) => [
      name,
      {
        id: `${index + 1}`,
        title: name,
        description: `${name} generated by the core component schematic.`,
        tags: ['demo', 'generated', '<%= fileName %>'],
      },
    ]),
  );

  search(query: string): string[] {
    const normalized = query.trim().toLowerCase();
    if (!normalized) {
      return [];
    }

    return MOCK_ITEMS.filter((item) => item.includes(normalized));
  }

  getDetails(name: string): <%= className %>Details | null {
    return this.#details.get(name) ?? null;
  }
}
