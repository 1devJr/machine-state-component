<section class="core-shell">
  <header class="core-shell__header">
    <div>
      <h2><%= className %> Core</h2>
      <p>Artifact-first scaffold generated by the local Nx generator.</p>
    </div>

    <button type="button" class="core-shell__button" (click)="reset()">
      Reset
    </button>
  </header>

  <section class="core-shell__badges">
    <span>Status: {{ status() }}</span>
    <span>Details status: {{ selections.detailsStatus() }}</span>
  </section>

  <section class="core-shell__search core-card">
    <div
      [uiEngineSlot]="composition.slotIds.input"
      [pluggable]="composition.slots.input"
      [facade]="facade.engineFacade"
    ></div>
  </section>

  <section class="core-shell__content">
    <div class="core-card">
      <h3>Results</h3>
      <div
        [uiEngineSlot]="composition.slotIds.results"
        [pluggable]="composition.slots.results"
        [facade]="facade.engineFacade"
      ></div>
    </div>

    <div class="core-card">
      <h3>Details</h3>
      <div
        [uiEngineSlot]="composition.slotIds.details"
        [pluggable]="composition.slots.details"
        [facade]="facade.engineFacade"
      ></div>
    </div>
  </section>

  <footer class="core-shell__footer">
    <span>Registered slices: input, results, details</span>
    <span>{{ slotSummary() }}</span>
  </footer>
</section>
