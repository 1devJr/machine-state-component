import { defineKernelEffects } from '@machine-state-component/ui-state';
import { <%= propertyName %>Actions } from './<%= fileName %>.actions';
import {
  <%= className %>Services,
  <%= className %>State,
} from './<%= fileName %>.types';

export function create<%= className %>Effects() {
  return defineKernelEffects<<%= className %>State, <%= className %>Services>()(
    <%= propertyName %>Actions,
    ({ on, actions }) => [
      on(actions.submit, {
        id: '<%= fileName %>-submit-effect',
        priority: 10,
        handler: ({ state, dispatch, services }) => {
          const query = state.query.trim();
          if (!query) {
            dispatch(actions.error('Provide a search term.'));
            return;
          }

          dispatch(actions.loading());
          const results = services.dataApi.search(query);

          if (!results.length) {
            dispatch(actions.error('No results found.'));
            return;
          }

          dispatch(actions.success(results));
        },
      }),
      on(actions.selectItem, {
        id: '<%= fileName %>-details-effect',
        priority: 20,
        handler: ({ event, dispatch, services }) => {
          const name = event.name.trim();
          if (!name) {
            dispatch(actions.detailsError('Invalid item.'));
            return;
          }

          dispatch(actions.detailsLoading(name));
          const details = services.dataApi.getDetails(name);

          if (!details) {
            dispatch(actions.detailsError('Details not found.'));
            return;
          }

          dispatch(actions.detailsSuccess(details));
        },
      }),
    ],
  );
}
