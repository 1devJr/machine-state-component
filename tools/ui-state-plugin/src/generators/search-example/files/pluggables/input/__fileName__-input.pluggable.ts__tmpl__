import { ChangeDetectionStrategy, Component, signal } from '@angular/core';
import { definePluggableStoreArtifacts } from '@machine-state-component/ui-state';
import { <%= propertyName %>Actions } from '../../store/<%= fileName %>.actions';
import { PluggableBase } from '../../store/<%= fileName %>.kernel';
import { <%= className %>InputConfig } from '../../store/<%= fileName %>.types';

@Component({
  selector: 'app-<%= fileName %>-input-pluggable',
  standalone: true,
  templateUrl: './<%= fileName %>-input.pluggable.html',
  styleUrl: './<%= fileName %>-input.pluggable.scss',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class <%= className %>InputPluggableComponent extends PluggableBase<<%= className %>InputConfig> {
  static readonly storeArtifacts = definePluggableStoreArtifacts({});

  readonly localQuery = signal('');

  protected override getDefaultConfig(): <%= className %>InputConfig {
    return {
      placeholder: 'Search',
      buttonLabel: 'Submit',
    };
  }

  updateQuery(value: string): void {
    this.localQuery.set(value);
    this.dispatch(<%= propertyName %>Actions.queryChanged(value));
  }

  submit(): void {
    const query = this.localQuery().trim();
    this.dispatch(<%= propertyName %>Actions.queryChanged(query));
    this.dispatch(<%= propertyName %>Actions.submit());
  }
}
