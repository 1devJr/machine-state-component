.input-pluggable {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.75rem;
}

input,
button {
  font: inherit;
}

input {
  border: 2px solid #202020;
  border-radius: 0.85rem;
  padding: 0.75rem 0.9rem;
}

button {
  border: 2px solid #202020;
  border-radius: 0.85rem;
  padding: 0.75rem 1rem;
  background: #dff0ff;
  cursor: pointer;
}
