.details-panel {
  display: grid;
  gap: 0.75rem;
}

.details-panel header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
}

.details-panel h4,
.details-panel p,
.details-status,
.details-error,
.details-empty {
  margin: 0;
}

.details-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.details-tags li {
  border: 1px solid #202020;
  border-radius: 999px;
  padding: 0.25rem 0.6rem;
  background: #eef2ff;
}

.details-error {
  color: #991b1b;
}

.details-empty,
.details-status {
  color: #4b5563;
}
