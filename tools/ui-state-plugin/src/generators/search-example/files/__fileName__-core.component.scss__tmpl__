:host {
  display: block;
}

.core-shell {
  display: grid;
  gap: 1rem;
  padding: 1.5rem;
  border: 2px solid #202020;
  border-radius: 1.25rem;
  background:
    linear-gradient(145deg, #f7f3e8 0%, #ffffff 100%);
  box-shadow: 0 18px 48px rgba(17, 24, 39, 0.14);
}

.core-shell__header,
.core-shell__badges,
.core-shell__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.core-shell__header h2 {
  margin: 0;
  font-size: 1.75rem;
}

.core-shell__header p {
  margin: 0.35rem 0 0;
  color: #46505a;
}

.core-shell__button {
  border: 2px solid #202020;
  border-radius: 999px;
  padding: 0.7rem 1.1rem;
  background: #f4d03f;
  font-weight: 700;
  cursor: pointer;
}

.core-shell__badges span,
.core-shell__footer span {
  border: 1px solid #202020;
  border-radius: 999px;
  padding: 0.35rem 0.75rem;
  background: #f4f1ea;
  font-size: 0.9rem;
}

.core-shell__content {
  display: grid;
  gap: 1rem;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
}

.core-card {
  display: grid;
  gap: 0.75rem;
  padding: 1rem;
  border: 2px solid #202020;
  border-radius: 1rem;
  background: #ffffff;
}

.core-card h3 {
  margin: 0;
}

@media (max-width: 900px) {
  .core-shell__content {
    grid-template-columns: 1fr;
  }
}
